rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A user's profile doc (email, notify preference, timezone).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // A user's todos — only the owner can read/write them.
      match /todos/{todoId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
